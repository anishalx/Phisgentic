# PhishGuard AI - Configuration

# Required -- Primary LLM
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional -- Enables dual-model cross-verification
# Get yours from https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Enable dual-model consensus (set to "false" to disable; enabled by default)
DUAL_MODEL_ENABLED=true

# Optional -- Enables Google Safe Browsing external threat intelligence
# Get yours from https://console.cloud.google.com/ (Enable Safe Browsing API)
GOOGLE_SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here

# Server port (default: 3001)
# PORT=3001

# Environment mode (default: development)
# NODE_ENV=development

# Disable Playwright-based tester agent (for platforms without browser support)
# DISABLE_TESTER_AGENT=false

# Disable vision-based logo detection
# DISABLE_VISION_DETECTION=false

# Dashboard URL for CORS in production
# DASHBOARD_URL=https://your-dashboard-url.com
