# PhishGuard API Configuration

# Server Port
PORT=3001

# Groq API Key - Primary LLM (Get yours from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key - Secondary LLM for dual-model consensus
# Get yours from https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Dual-Model Consensus (enabled by default, set to "false" to disable)
DUAL_MODEL_ENABLED=true

# Google Safe Browsing API Key - External threat intelligence
# Get yours from https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# Free tier: 10,000 lookups/day. Significantly improves phishing detection.
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# Dashboard URL for CORS (production only)
# DASHBOARD_URL=https://your-dashboard.vercel.app
